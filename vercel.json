{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {
    "api/glucose.py": {
      "maxDuration": 30,
      "excludeFiles": "{local-glucose/**,node_modules/**,tests/**,.git/**,dist/**,public/**,src/**}"
    }
  },
  "headers": [{"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"},{"key":"Service-Worker-Allowed","value":"/"}]}],
  "rewrites": [
    {"source":"/api/glucose/:op","destination":"/api/glucose?op=:op"},
    {"source":"/api/live","destination":"https://onbit-monitor.vercel.app/api/live"},
    {"source":"/((?!api/).*)","destination":"/index.html"}
  ]
}
